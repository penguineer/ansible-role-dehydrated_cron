#!/bin/bash

SPAN={{ dehydrated_check_span }}

shopt -s nullglob
CERT_DIRS=( "{{ dehydrated_certs_dir }}"/*/ )

if [ "${#CERT_DIRS[@]}" -eq 0 ]; then
    exit 0
fi

check_certs() {
    for cert_dir in "${CERT_DIRS[@]}"; do
        pem="${cert_dir}cert.pem"

        if [ ! -f "$pem" ]; then
            printf 'Missing cert.pem in %s\n' "$cert_dir"
            continue
        fi

        openssl x509 -checkend "$SPAN" -noout -in "$pem" >/dev/null
        RETURN=$?

        if [ "0${RETURN}" -ne "0" ]; then
            printf '%s: %s\n' \
                "$(date --date="$(openssl x509 -enddate -noout -in "$pem" | cut -d= -f 2)" --iso-8601)" \
                "$pem"
        fi
    done | sort
}

issues="$(check_certs)"

if [ -n "$issues" ]; then
    OUTPUT="Certificate check found problems:

${issues}"
    echo "$OUTPUT"
{% if dehydrated_mail_to %}
    echo "$OUTPUT" | mail -s "{{ dehydrated_mail_subject_prefix }} Certificate check failed" "{{ dehydrated_mail_to }}"
{% endif %}

    if grep -q '^Missing cert.pem in ' <<<"$issues"; then
        exit 1
    fi
fi
